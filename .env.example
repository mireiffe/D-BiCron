# ── pg2ch / Airflow 환경변수 ──────────────────────────────────────────
# .env 로 복사해 채운다 (docker compose 가 자동 로드).

# 소스/타겟 DB 비밀 (connections.json 의 ${PG_PASSWORD} 등으로 참조됨)
PG_PASSWORD=changeme
CH_PASSWORD=

# pg2ch 설정 경로 (컨테이너 내부 기준; 기본값으로 충분하면 비워 둬도 됨)
PG2CH_CONNECTIONS=/opt/airflow/config/connections.json
PG2CH_TABLES_DIR=/opt/airflow/config/tables

# ── Airflow ──────────────────────────────────────────────────────────
# Airflow 메타DB 접속 (compose 의 postgres 서비스)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# 컨테이너 UID (Linux 권한 문제 방지). `id -u` 결과를 넣는다.
AIRFLOW_UID=50000

# Airflow 내부 컴포넌트(api-server↔scheduler↔task) 간 JWT 서명 공유 시크릿.
# ⚠️ 모든 컨테이너가 동일 값을 써야 한다. 값을 바꾸면 반드시 전체 재생성:
#       docker compose down && docker compose up -d
#    (부분 재시작 시 컨테이너마다 시크릿이 갈려 InvalidSignatureError 가 반복된다.)
# 비워 두면 compose 의 dev 기본값이 모든 컨테이너에 동일 적용된다(로컬 OK).
# 공유/운영 환경에서는 강한 랜덤값을 직접 지정:
#       python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_JWT_SECRET=

# Airflow 메타DB 의 connection/variable 암호화 키(Fernet).
# 비워 두면 비암호화 저장. 한 번 생성해 고정하고 이후 바꾸지 말 것(복호화 불가):
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# [개발 전용] 로컬에서 로그인 없이 admin 으로 들어가려면 true 로 설정.
# 기본 false (보안). 공유/운영 환경에서는 절대 true 로 두지 말 것.
# 운영 로그인은 SimpleAuthManager 생성 비밀번호 또는 FAB 인증매니저 사용 (README 참조).
AIRFLOW_ALL_ADMINS=false

# ── 사내 사설 패키지 저장소(미러) — 선택 ──────────────────────────────
# 인터넷 차단망에서 `docker compose build` 가 패키지를 사내 미러로 받도록
# build.args 로 전달된다. 비워 두면 평소처럼 공용 PyPI 를 탄다.
#
# pip 사설 미러 (이 이미지는 pip 로 설치 — 실제로 쓰이는 값)
# 예: https://nexus.example.com/repository/pypi/simple
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
# 미러가 사설 인증서/HTTP 라면 신뢰 호스트 지정 (예: nexus.example.com)
PIP_TRUSTED_HOST=
# uv / npm 을 빌드에서 쓸 경우용 (현재 Dockerfile 은 pip 만 사용)
UV_INDEX_URL=
NPM_CONFIG_REGISTRY=
