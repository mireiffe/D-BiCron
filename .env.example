# ── pg2ch / Airflow 환경변수 ──────────────────────────────────────────
# .env 로 복사해 채운다 (docker compose 가 자동 로드).

# 소스/타겟 DB 비밀 (connections.json 의 ${PG_PASSWORD} 등으로 참조됨)
PG_PASSWORD=changeme
CH_PASSWORD=

# pg2ch 설정 경로 (컨테이너 내부 기준; 기본값으로 충분하면 비워 둬도 됨)
PG2CH_CONNECTIONS=/opt/airflow/config/connections.json
PG2CH_TABLES_DIR=/opt/airflow/config/tables

# ── Airflow ──────────────────────────────────────────────────────────
# Airflow 메타DB 접속 (compose 의 postgres 서비스)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# 컨테이너 UID (Linux 권한 문제 방지). `id -u` 결과를 넣는다.
AIRFLOW_UID=50000

# 초기 admin 계정 (standalone/apiserver)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
