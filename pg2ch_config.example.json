{
  "_comment": "PostgreSQL → ClickHouse 동기화 설정. source/target 은 databases.json 의 DB ID",
  "_label": "shop orders",
  "source": "my_postgres",
  "target": "my_clickhouse",
  "ch_native_port": 9000,
  "defaults": {
    "engine": "ReplacingMergeTree",
    "full_copy_strategy": "python_stream",
    "full_copy_fallback_to_python": true,
    "clickhouse_postgresql_host": "postgres",
    "clickhouse_postgresql_port": 5432,
    "batch_size": 100000,
    "source_retention_batch_size": 10000,
    "overlap_minutes": 0,
    "watermark_overlap": 0,
    "settings": {
      "index_granularity": 8192
    }
  },
  "tables": [
    {
      "source_table": "public.orders",
      "target_table": "default.orders",
      "timestamp_column": "updated_at",
      "sync_since": "30d",
      "source_retention": "180d",
      "engine": "ReplacingMergeTree(updated_at)",
      "order_by": ["id"],
      "primary_key": ["id"],
      "partition_by": "toYYYYMM(created_at)",
      "indexes": [
        {
          "name": "idx_status",
          "column": "status",
          "type": "set(1000)",
          "granularity": 1
        }
      ],
      "drop_columns": ["internal_note", "debug_payload"],
      "column_overrides": {
        "status": "LowCardinality(String)",
        "country": "LowCardinality(String)",
        "amount": "Decimal(18,4)"
      },
      "batch_size": 50000,
      "overlap_minutes": 30,
      "use_nullable": false,
      "optimize_after_sync": true,
      "optimize_partitions": ["202605", "202606"],
      "optimize_mutations_sync": 2
    },
    {
      "source_table": "public.event_logs",
      "target_table": "default.event_logs",
      "timestamp_column": "created_at",
      "watermark_column": "sync_id",
      "watermark_overlap": 100000,
      "engine": "MergeTree",
      "order_by": ["event_type", "created_at"],
      "partition_by": "toYYYYMMDD(created_at)",
      "drop_columns": [],
      "column_overrides": {
        "event_type": "LowCardinality(String)",
        "occurred_at_str": {
          "type": "DateTime64(3, 'UTC')",
          "parse_format": "%Y%m%d %H%M%S%f",
          "timezone": "Asia/Seoul"
        }
      }
    }
  ]
}
